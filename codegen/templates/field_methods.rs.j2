{#
  Per-field methods (setter / getter / has_), shared by every type that exposes a FIX field: the
  message facades and the repeating-group entry views (`group.rs.j2`). Macros only: this file is
  imported (`{% import "field_methods.rs.j2" as fm %}`) and never rendered on its own, so nothing
  outside a macro reaches the output.

  Parameters, the same in every macro:
    f        - a `FieldView` (emitter.rs): names, tag const, Rust/wire types, branch flags.
    req      - "required" / "optional", for the doc comments only.
    recv     - the Rust receiver to read from, as text: an expression of type `&FieldMap`
               (`self.msg.body()` on a message, `self.inner` on an entry view).
    recv_mut - the same for writing, of type `&mut FieldMap` (`self.msg.body_mut()`, `self.inner`).

  The callers pass `f`/`req` because macros can't see the caller's loop variables.

  `field_setter` and `field_getter` dispatch on the same three branches, in the same order, and
  must stay in sync:
    1. `f.accessor_uses_enum` - the generated enum (`Side`, `SecurityType`); the getter splits on
       `f.enum_from_string` for how it reads the wire code before `from_fix`.
    2. `f.codec`              - FIX text form differs from Rust's Display/FromStr (bool, Decimal,
       dates/times): `convert::format_<f.codec>` / `convert::parse_<f.codec>`.
    3. plain                  - Display/FromStr already match FIX. MULTIPLEVALUESTRING lands here:
       its value is one or more space-separated codes, so a raw `String` / `&str` (as QFJ).
  A new kind of type means a new codec in `convert.rs` + `codec_for` (emitter.rs), not a new branch.
  Branch conditions are decided in the emitter (view-model fields), never by inspecting strings
  here (D4d).
#}

{# Setter: Rust value in, FIX wire string stored. #}
{% macro field_setter(f, req, recv_mut) %}
{% if f.accessor_uses_enum %}
{# Value-constrained field: the generated enum on the outside, its wire value on the wire. #}
    /// Set `{{ f.xml_name }}` (tag {{ f.tag }}, {{ req }}).
    pub fn set_{{ f.accessor }}(&mut self, v: fields::{{ f.enum_name }}) {
        {{ recv_mut }}.set_field(tags::{{ f.tag_const }}, v.to_fix().to_string());
    }
{% elif f.codec %}
{# Rust's Display doesn't produce the FIX form (`Y`/`N`, FIX timestamps, ...): convert.rs does. #}
    /// Set `{{ f.xml_name }}` (tag {{ f.tag }}, {{ req }}); written in FIX `{{ f.fix_type }}` format.
    pub fn set_{{ f.accessor }}(&mut self, v: {{ f.setter_param }}) {
        {{ recv_mut }}.set_field(tags::{{ f.tag_const }}, convert::format_{{ f.codec }}(v));
    }
{% else %}
{# Plain field: Rust's Display already matches FIX here. #}
    /// Set `{{ f.xml_name }}` (tag {{ f.tag }}, {{ req }}).
    pub fn set_{{ f.accessor }}(&mut self, v: {{ f.setter_param }}) {
        {{ recv_mut }}.set_field(tags::{{ f.tag_const }}, v.to_string());
    }
{% endif %}
{% endmacro %}

{# Getter: FIX wire string parsed to the Rust value. `Err(TagNotFound)` if absent,
   `Err(InvalidFormat)` if present but not a valid value. #}
{% macro field_getter(f, req, recv) %}
{% if f.accessor_uses_enum %}
{# Read the wire code, then map it to the enum; an unlisted value is InvalidFormat. #}
    /// `{{ f.xml_name }}` (tag {{ f.tag }}, {{ req }}). `Err(InvalidFormat)` if the value isn't one
    /// of [`fields::{{ f.enum_name }}`]'s.
    {% if f.enum_from_string %}
    {# String code: `&str` has no FromStr, so read an owned String and borrow it for from_fix. #}
        pub fn {{ f.accessor }}(&self) -> Result<fields::{{ f.enum_name }}, FieldError> {
            let raw = {{ recv }}.get_field::<String>(tags::{{ f.tag_const }})?;
            fields::{{ f.enum_name }}::from_fix(&raw).ok_or(FieldError::InvalidFormat { tag: tags::{{ f.tag_const }} })
        }
    {% else %}
    {# char / i32 / u32 code: parse it straight to the wire type. #}
    pub fn {{ f.accessor }}(&self) -> Result<fields::{{ f.enum_name }}, FieldError> {
        let n = {{ recv }}.get_field::<{{ f.wire_type }}>(tags::{{ f.tag_const }})?;
        fields::{{ f.enum_name }}::from_fix(n).ok_or(FieldError::InvalidFormat { tag: tags::{{ f.tag_const }} })
    }
    {% endif %}
{% elif f.codec %}
{# Read the raw string; convert.rs parses the FIX form. #}
    /// `{{ f.xml_name }}` (tag {{ f.tag }}, {{ req }}). `Err(InvalidFormat)` unless a valid FIX
    /// `{{ f.fix_type }}`.
    pub fn {{ f.accessor }}(&self) -> Result<{{ f.value_type }}, FieldError> {
        let raw = {{ recv }}.get_field::<String>(tags::{{ f.tag_const }})?;
        convert::parse_{{ f.codec }}(&raw, tags::{{ f.tag_const }})
    }
{% else %}
{# Plain field: Rust's FromStr already matches FIX here. #}
    /// `{{ f.xml_name }}` (tag {{ f.tag }}, {{ req }}).
    pub fn {{ f.accessor }}(&self) -> Result<{{ f.value_type }}, FieldError> {
        {{ recv }}.get_field::<{{ f.value_type }}>(tags::{{ f.tag_const }})
    }
{% endif %}
{% endmacro %}

{# Presence check, for every field (D2), independent of `required` and of the field's type. #}
{% macro field_has(f, recv) %}
    /// Whether `{{ f.xml_name }}` (tag {{ f.tag }}) is set. Presence only: a set but malformed
    /// value still counts.
    pub fn has_{{ f.accessor }}(&self) -> bool {
        {{ recv }}.has_field(tags::{{ f.tag_const }})
    }
{% endmacro %}
